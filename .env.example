# Application Secret Key
SECRET_KEY=generate-a-strong-secret-key-for-production-use

# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py

# MySQL Database Configuration (Local / XAMPP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=retirement_clearance_db

# Cloud Database URL (Overrides discrete credentials if provided - supports MySQL or Neon PostgreSQL)
# DATABASE_URL=postgresql://neondb_owner:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=mysql+pymysql://user:pass@host:port/dbname?charset=utf8mb4

# Session Timeout (Minutes)
SESSION_TIMEOUT_MINUTES=60

# Optional OCR & Biometrics Paths
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
BIOMETRIC_HARDWARE_ENABLED=False

# Server Port
PORT=5000
